# =========================================================================
# US BENGOL - Supabase Environment Configuration Template
# =========================================================================
# 
# Instructions:
# 1. Create a project at https://supabase.com
# 2. In Supabase Dashboard -> Project Settings -> API:
#    - Copy your Project URL to SUPABASE_URL
#    - Copy your "anon" public key to SUPABASE_ANON_KEY
# 3. In Supabase SQL Editor:
#    - Run the provided `supabase_schema.sql` script to create tables and RLS policies.
# 4. For static client-side deployment (Vercel / GitHub Pages), you can also
#    configure these keys inside `js/supabase.js` or via the interactive 
#    Admin Panel Settings interface (Stored securely in browser localStorage).
# 
# NEVER expose your service_role key to the frontend!
# =========================================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
