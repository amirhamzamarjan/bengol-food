{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/product/:slug",
      "destination": "/product.html?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/products",
      "destination": "/admin/products.html"
    },
    {
      "source": "/admin/gallery",
      "destination": "/admin/gallery.html"
    },
    {
      "source": "/admin/requests",
      "destination": "/admin/requests.html"
    },
    {
      "source": "/admin/content",
      "destination": "/admin/content.html"
    },
    {
      "source": "/admin/settings",
      "destination": "/admin/index.html"
    },
    {
      "source": "/products",
      "destination": "/admin/products.html"
    },
    {
      "source": "/gallery",
      "destination": "/admin/gallery.html"
    },
    {
      "source": "/requests",
      "destination": "/admin/requests.html"
    },
    {
      "source": "/content",
      "destination": "/admin/content.html"
    },
    {
      "source": "/settings",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
